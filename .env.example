# Z.AI GLM Coding Plan API key — https://z.ai/subscribe
GLM_API_KEY=your-z-ai-key

# Optional: OpenRouter API key. Picked up by Hermes' auxiliary "auto" chain
# (vision/web_extract/session_search side-tasks), so setting this stops the
# "marking openrouter unhealthy" warnings. Leave empty if you don't use it.
OPENROUTER_API_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-...

# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Default-deny: if empty, Hermes refuses EVERYONE. Get your ID from @userinfobot.
TELEGRAM_ALLOWED_USERS=123456789

# Comma-separated Telegram group/supergroup chat IDs the bot is allowed to operate in.
# Supergroup IDs are negative (e.g. -1001234567890). Leave empty for DM-only.
TELEGRAM_GROUP_ALLOWED_CHATS=

# --- Akave persistent storage (rclone crypt) -------------------------------
# Used by the rclone sidecars (compose.yaml / compose-openrouter.yaml) and
# by `just test-akave`. The connection test needs all six below.
#
# Create a bucket + access key pair at https://console.akave.com/ — the console
# shows a per-credential endpoint URL (copy it into AKAVE_ENDPOINT).
AKAVE_ENDPOINT=
AKAVE_ACCESS_KEY=
AKAVE_SECRET_KEY=
AKAVE_BUCKET=

# Client-side encryption for the bucket. BOTH values must be obscured first:
#   just obscure "$(openssl rand -base64 48)"   # -> RCLONE_CRYPT_PASSWORD
#   just obscure "$(openssl rand -base64 32)"   # -> RCLONE_CRYPT_SALT
# Save the ORIGINAL (un-obscured) values in a password manager: losing both the
# passphrase and the salt makes every file in the bucket unrecoverable.
RCLONE_CRYPT_PASSWORD=
RCLONE_CRYPT_SALT=

# Optional: seconds between sync cycles (sidecars only, default 300).
# SYNC_INTERVAL=300

# --- Cloudflare R2 + restic ------------------------------------------------
# The restic backup path. Runs ALONGSIDE the Akave/rclone sidecars above until
# the cutover, so keep both sets of values populated.
#
# Set up at https://dash.cloudflare.com/ -> R2:
#
#   1. Create a bucket. Its exact name goes in R2_BUCKET. Select the EU
#      jurisdiction at creation time if you want the data pinned to the EU;
#      you cannot change it later.
#   2. Copy the Account ID from the R2 overview page into R2_ACCOUNT_ID. The
#      S3 endpoint is built from it, so do not set an endpoint by hand:
#        https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#   3. R2 -> API -> Manage API tokens -> Create Account API token.
#      Permission "Object Read & Write", scoped to that one bucket. restic
#      never needs bucket-admin rights.
#      The Secret Access Key is shown ONCE. Copy it now.
#   4. On the bucket, add a lifecycle rule that aborts incomplete multipart
#      uploads after 1 day. A ROFL machine can die mid-backup, and the orphaned
#      parts are billed as storage until something deletes them.
#
# The S3 region for R2 is always "auto". The compose files set it; do not add it.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# restic repository password.
# Do NOT run `just obscure` on this one. Unlike RCLONE_CRYPT_* above, restic
# takes the value raw — obscuring it locks you out of the repository.
# Generate with:
#   openssl rand -base64 48
# Save the value in a password manager. There is no recovery path: lose it and
# every snapshot is permanently unreadable.
RESTIC_PASSWORD=

# Optional: seconds between restic backup runs (default 3600).
# restic's request count does not scale with backup frequency the way rclone's
# did, so tightening this costs almost nothing.
# BACKUP_INTERVAL=3600

# ───────────────────────── GATEWAY ─────────────────────────

# Comma-separated allowlist of Ethereum addresses (case-insensitive).
WALLET_WHITELIST=0xYourAddress1,0xYourAddress2

# Session-signing key. SECRET. MUST be stable and >= 32 chars. Generate with:
#   openssl rand -hex 32
WALLET_SESSION_SECRET=replace-with-openssl-rand-hex-32

# Public host the dashboard is served from (no scheme). 
# On ROFL set this to the proxy host (oasis rofl machine show).
WALLET_DOMAIN=localhost:8080

# Hermes' own auth gate is mandatory for the dashboard's non-loopback bind.
# Generate the password hash with the Hermes image and keep the surrounding
# single quotes so Compose treats the hash's `$` characters literally.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH='scrypt$...'
# Stable session-signing key; generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-openssl-rand-hex-32

# ──────────────────── SECURITY DASHBOARD ────────────────────

# Bearer token the security dashboard (served under /security) requires on its
# write API — the endpoints the security-review cron pushes findings to. The
# SAME value goes to the dashboard service (to enforce) and to the cron (to
# authenticate its pushes). Generate with:
#   openssl rand -hex 32
# If left empty the dashboard logs a loud warning and accepts UNauthenticated
# writes, so set it.
HERMES_API_TOKEN=replace-with-openssl-rand-hex-32
